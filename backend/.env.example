# Copier ce fichier en « .env » et ajuster au besoin.
# En développement, aucune variable n'est obligatoire : les valeurs par défaut
# suffisent.

DJANGO_SECRET_KEY=dev-secret-key-a-remplacer-en-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées à appeler l'API depuis un autre site, séparées par des
# virgules (schéma, hôte et port exacts, sans « / » final). Y ajouter celle de
# l'application IPM Mobile (pwa/) quand elle est servie ailleurs que l'API —
# sur le serveur de test : https://sar-integration.sar.sn:8443.
DJANGO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Base de données ---------------------------------------------------------
# Laisser vide en développement = SQLite. En production, renseigner ces
# variables pour utiliser NOTRE PostgreSQL (le serveur local postgresql-x64-17).
# Les données affichées viennent alors exclusivement de cette base.
DB_NAME=ipm
DB_USER=ipm
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
