<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuration IIS du site IPM.

  Le front est un ensemble de fichiers statiques ; IIS les sert directement.
  Les deux règles ci-dessous relaient vers Django ce qui lui appartient — l'API
  et la console d'administration — de sorte que tout passe par une seule
  origine : pas de CORS, un seul port ouvert, une seule adresse à retenir.

  Ce fichier est la source de vérité : il est recopié vers la racine du site
  par deploy\publier.ps1 à chaque publication.
-->
<configuration>
  <system.webServer>

    <directoryBrowse enabled="false" />

    <rewrite>
      <rules>
        <!--
          {R:0} reprend l'URL entrante telle quelle : /api/donnees-de-base/x
          arrive à Django sous ce même chemin. L'espace d'URL du backend reste
          donc identique à ce qu'il est en développement — rien à préfixer ni à
          retirer côté Django.
        -->
        <rule name="API Django" stopProcessing="true">
          <match url="^api/.*" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:0}" />
        </rule>

        <rule name="Admin Django" stopProcessing="true">
          <match url="^admin(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:0}" />
        </rule>

        <!--
          Pas de règle de repli SPA : l'application navigue en HashRouter
          (/#/participants), donc le serveur ne voit jamais qu'une seule URL,
          « / ». Les chemins internes vivent après le dièse, côté navigateur.
        -->
      </rules>
    </rewrite>

    <staticContent>
      <!-- manifest.json : le type MIME n'est pas déclaré sur toutes les
           installations d'IIS, et sans lui le fichier est renvoyé en 404. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

  </system.webServer>
</configuration>
