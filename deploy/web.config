<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuration IIS du site IPM.

  Le front est un ensemble de fichiers statiques ; IIS les sert directement.
  Les deux règles ci-dessous relaient vers Django ce qui lui appartient — l'API
  et la console d'administration — de sorte que tout passe par une seule
  origine : pas de CORS, un seul port ouvert, une seule adresse à retenir.

  Ce fichier est la source de vérité : il est recopié vers la racine du site
  par deploy\publier.ps1 à chaque publication.
-->
<configuration>
  <system.webServer>

    <directoryBrowse enabled="false" />

    <rewrite>
      <rules>
        <!--
          {R:0} reprend l'URL entrante telle quelle : /api/donnees-de-base/x
          arrive à Django sous ce même chemin. L'espace d'URL du backend reste
          donc identique à ce qu'il est en développement — rien à préfixer ni à
          retirer côté Django.
        -->
        <rule name="API Django" stopProcessing="true">
          <match url="^api/.*" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:0}" />
        </rule>

        <rule name="Admin Django" stopProcessing="true">
          <match url="^admin(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:0}" />
        </rule>

        <!--
          Pas de règle de repli SPA : l'application navigue en HashRouter
          (/#/participants), donc le serveur ne voit jamais qu'une seule URL,
          « / ». Les chemins internes vivent après le dièse, côté navigateur.
        -->
      </rules>
    </rewrite>

    <staticContent>
      <!--
        Cache du navigateur, en deux temps.
        Par défaut — index.html compris, qu'IIS sert aussi pour « / » — le
        navigateur revérifie chaque fichier auprès du serveur (« no-cache ») :
        une publication se voit dès le rechargement suivant, sans Ctrl+F5. La
        revérification est légère, IIS répondant « 304 » quand rien n'a changé.
        Les bundles de /assets, eux, se gardent un an : voir plus bas.
      -->
      <clientCache cacheControlMode="DisableCache" />

      <!-- manifest.json : le type MIME n'est pas déclaré sur toutes les
           installations d'IIS, et sans lui le fichier est renvoyé en 404. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

  </system.webServer>

  <!--
    Les fichiers de /assets portent une empreinte dans leur nom
    (index-COLW_3zf.js) : un nouveau build produit de nouveaux noms, un nom
    donné ne change donc jamais de contenu. Le navigateur peut les garder un an
    sans jamais les revérifier — c'est index.html, toujours frais, qui dit
    lesquels charger.
  -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="immutable" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
