# Variables du build de production (lues par Vite, cf. services/api.js).
#
# Chemin relatif et non URL absolue : IIS sert le front et relaie /api/ vers
# Django sur la même origine. Le site fonctionne donc tel quel quelle que soit
# l'adresse par laquelle on l'atteint — IP, nom de machine, plus tard un nom de
# domaine — sans reconstruire le front.
VITE_API_BASE=/api
