<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuration IIS du site IPM-Mobile (PWA des bons de pharmacie).

  Le PWA n'est qu'un ensemble de fichiers statiques : IIS les sert tels quels.
  Contrairement au site IPM, il n'y a AUCUN relais vers Django ici : l'API vit
  sur une autre origine (https://sar-integration.sar.sn/api), lue au démarrage
  dans /config.json. C'est voulu — le PWA sera un jour hébergé ailleurs, et il
  doit déjà fonctionner en inter-origine (CORS) comme il le fera alors.

  Ce fichier est la source de vérité : il est recopié vers la racine du site
  par pwa\deploy\publier.ps1 à chaque publication. publier.ps1 y ajuste au
  passage la directive connect-src de la CSP à l'origine passée en -ApiBase.

  Prérequis : module IIS URL Rewrite (déjà installé pour le site IPM). Sans
  lui, la section <rewrite> est inconnue et IIS répond 500.19 à tout.
-->
<configuration>
  <system.webServer>

    <directoryBrowse enabled="false" />

    <rewrite>
      <rules>
        <!--
          Repli SPA. Ionic React navigue en BrowserRouter (/bons/12), pas en
          HashRouter comme le front IPM : quand on recharge la page, ou qu'on
          ouvre l'application installée sur une URL profonde, le navigateur
          demande réellement /bons/12 au serveur. Toute URL qui n'est ni un
          fichier ni un dossier existant reçoit donc index.html, et le routeur
          du navigateur prend le relais.

          Deux exclusions, pour qu'une ressource manquante reste une vraie 404
          au lieu de renvoyer du HTML avec un statut 200 (que le navigateur
          tenterait d'exécuter comme du JavaScript, et que le service worker
          pourrait mettre en cache) :
            - tout ce qui est sous assets/ (bundles au nom haché) ;
            - toute URL qui se termine par une extension (.js, .png, .json…).
          Les routes de l'application n'ont jamais d'extension.
        -->
        <rule name="Repli SPA" stopProcessing="true">
          <match url="^(?!assets/)(?!.*\.[A-Za-z0-9]+$).*$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <!--
        Cache du navigateur, en deux temps (comme pour le site IPM).
        Par défaut, tout fichier est revérifié auprès du serveur à chaque
        usage (« Cache-Control: no-cache ») ; IIS répond « 304 » quand rien n'a
        changé, la revérification est donc légère. C'est indispensable pour :
          - sw.js : le navigateur ne détecterait pas la nouvelle version du
            service worker, et les téléphones resteraient sur l'ancienne ;
          - index.html : c'est lui qui désigne les bundles à charger ;
          - config.json : l'adresse de l'API doit pouvoir changer sans
            republier l'application ;
          - manifest.webmanifest : nom, icônes et couleurs de l'application
            installée.
        Ces quatre fichiers sont en plus repris nommément plus bas, pour que la
        règle tienne même si ce défaut venait à changer.
        Les bundles de /assets, eux, se gardent un an : voir plus bas.
      -->
      <clientCache cacheControlMode="DisableCache" />

      <!--
        Types MIME absents (ou pas partout) de la configuration par défaut
        d'IIS : sans déclaration, IIS renvoie ces fichiers en 404. On retire
        puis on ajoute, pour ne pas provoquer d'erreur de doublon sur un
        serveur qui les déclarerait déjà.
          - .webmanifest : manifeste du PWA (type exigé par les navigateurs) ;
          - .json        : config.json ;
          - .mjs         : worker de pdf.js (module ES) ;
          - .wasm        : décodeurs d'images optionnels de pdf.js ;
          - .woff2       : polices éventuelles.
      -->
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <httpProtocol>
      <customHeaders>
        <!-- Inutile d'annoncer la technologie du serveur. -->
        <remove name="X-Powered-By" />

        <!-- Le navigateur respecte le type MIME annoncé, sans le deviner. -->
        <add name="X-Content-Type-Options" value="nosniff" />

        <!--
          Les appels à l'API (autre origine) ne transmettent que l'origine du
          PWA, jamais le chemin complet de la page (qui peut contenir un
          numéro de bon).
        -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

        <!--
          Fonctions sensibles du navigateur dont l'application n'a pas l'usage.
          Le partage (Web Share, « Partager / Imprimer ») n'est volontairement
          PAS dans la liste : il doit rester permis. La géolocalisation est
          permise à l'application elle-même (self) : la carte d'itinéraire
          vers une structure conventionnée part de la position de l'employé.
        -->
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(self), payment=(), usb=(), serial=(), bluetooth=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=()" />

        <!--
          Politique de sécurité du contenu.
            - script-src 'self' 'wasm-unsafe-eval' : uniquement nos bundles ;
              'wasm-unsafe-eval' autorise les décodeurs WebAssembly de pdf.js,
              sans autoriser eval() pour autant (pdf.js s'en passe).
            - worker-src 'self' blob: : le service worker (sw.js) et le worker
              de pdf.js (assets/pdf.worker-*.mjs), servis par ce site.
            - style-src 'unsafe-inline' : Ionic pose des styles en ligne sur ses
              composants (animations, safe areas) ; impossible sans.
            - img-src / font-src data: blob: : icônes intégrées, rendus de
              pdf.js ; img-src tile.openstreetmap.org : les fonds de la
              carte d'itinéraire.
            - connect-src : ce site (config.json) + l'origine de l'API +
              le calcul d'itinéraire (router.project-osrm.org) ; blob:
              pour relire le PDF mis en cache hors-ligne ; data: pour les
              icônes Ionicons, que <ion-icon> lit par fetch(). publier.ps1
              remplace l'origine de l'API par celle de -ApiBase.
            - frame-ancestors 'none' : l'application ne s'affiche jamais dans
              un cadre (protection contre le détournement de clic).
          Pas de Strict-Transport-Security : HSTS vaut pour tout le nom d'hôte,
          tous ports confondus ; il forcerait aussi le HTTPS sur le site IPM
          (port 80), ce qui n'est pas décidé.
        -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self' data: blob:; connect-src 'self' blob: data: https://router.project-osrm.org https://sar-integration.sar.sn; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" />
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!--
    Les fichiers de /assets portent une empreinte dans leur nom
    (index-COLW_3zf.js) : un nouveau build produit de nouveaux noms, un nom
    donné ne change donc jamais de contenu. Le navigateur peut les garder un an
    sans jamais les revérifier — c'est index.html, toujours frais, qui dit
    lesquels charger.
  -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Toujours revérifiés : voir l'explication plus haut. -->
  <location path="sw.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="config.json">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="manifest.webmanifest">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
